{
  "fixture_audio": "/opt/snack-gpt/probe/report.wav",
  "artifacts_directory": "/var/tmp/snack-gpt-voice-probe",
  "require_raspberry_pi_3b_plus": true,
  "network_isolation_command": [
    "/usr/bin/bwrap",
    "--unshare-net",
    "--bind",
    "/",
    "/",
    "--"
  ],
  "evidence_files": [
    "/opt/snack-gpt/bin/openwakeword-probe",
    "/opt/snack-gpt/models/hey_jarvis_v0.1.onnx",
    "/opt/snack-gpt/models/melspectrogram.onnx",
    "/opt/snack-gpt/models/embedding_model.onnx",
    "/opt/snack-gpt/bin/whisper-probe",
    "/opt/snack-gpt/bin/whisper-cli",
    "/opt/snack-gpt/bin/whisper-cli.commit",
    "/opt/snack-gpt/models/ggml-tiny.en.bin",
    "/opt/snack-gpt/bin/needle-probe",
    "/opt/snack-gpt/lib/libneedle.so",
    "/opt/snack-gpt/bin/piper-probe",
    "/opt/snack-gpt/bin/piper-worker",
    "/opt/snack-gpt/bin/piper",
    "/opt/snack-gpt/models/en_US-lessac-low.onnx",
    "/opt/snack-gpt/models/en_US-lessac-low.onnx.json",
    "/opt/snack-gpt/models/en_US-lessac-low.MODEL_CARD",
    "/opt/snack-gpt/venv/pyvenv.cfg",
    "/opt/snack-gpt/probe/python-packages.txt",
    "/opt/snack-gpt/probe/report.wav"
  ],
  "expected_transcript_terms": [
    "two",
    "eggs"
  ],
  "expected_extraction": {
    "foods": [
      {
        "food": "eggs",
        "quantity": 2
      }
    ]
  },
  "workers": [
    {
      "name": "piper",
      "command": [
        "/opt/snack-gpt/bin/piper-worker",
        "--model",
        "/opt/snack-gpt/models/en_US-lessac-low.onnx",
        "--socket",
        "{artifacts}/piper.sock"
      ],
      "ready_path": "{artifacts}/piper.sock"
    }
  ],
  "commands": {
    "wake_detection": [
      "/opt/snack-gpt/bin/openwakeword-probe",
      "--model",
      "/opt/snack-gpt/models/hey_jarvis_v0.1.onnx",
      "--audio",
      "{audio}",
      "--output",
      "{wake_result}"
    ],
    "transcription": [
      "/opt/snack-gpt/bin/whisper-probe",
      "--binary",
      "/opt/snack-gpt/bin/whisper-cli",
      "--model",
      "/opt/snack-gpt/models/ggml-tiny.en.bin",
      "--audio",
      "{audio}",
      "--output",
      "{transcript}"
    ],
    "extraction": [
      "/opt/snack-gpt/bin/needle-probe",
      "--library",
      "/opt/snack-gpt/lib/libneedle.so",
      "--transcript",
      "{transcript}",
      "--output",
      "{extraction}"
    ],
    "speech_synthesis": [
      "/opt/snack-gpt/bin/piper-probe",
      "--socket",
      "{artifacts}/piper.sock",
      "--extraction",
      "{extraction}",
      "--output",
      "{speech}"
    ]
  }
}